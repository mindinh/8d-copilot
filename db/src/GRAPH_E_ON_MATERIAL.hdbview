VIEW "GRAPH_E_ON_MATERIAL" AS SELECT
    CAST('ON_MATERIAL|' || "NOTIFICATIONID" AS NVARCHAR(200)) AS "EDGE_ID",
    CAST('CASE:' || "NOTIFICATIONID"        AS NVARCHAR(120)) AS "SOURCE_ID",
    CAST('MAT:'  || "MATERIALID"            AS NVARCHAR(120)) AS "TARGET_ID"
FROM "CNMA_PRORESOLVE_HISTORICALCASES"
WHERE "NOTIFICATIONID" IS NOT NULL AND "MATERIALID" IS NOT NULL
