VIEW "GRAPH_V_MATERIAL" AS SELECT
    CAST('MAT:' || "MATERIALID" AS NVARCHAR(120)) AS "NODE_ID",
    CAST("MATERIALID"           AS NVARCHAR(120)) AS "BIZ_KEY",
    CAST(MAX("MATERIALDESC")    AS NVARCHAR(255)) AS "TITLE"
FROM "CNMA_PRORESOLVE_HISTORICALCASES"
WHERE "MATERIALID" IS NOT NULL
GROUP BY "MATERIALID"
