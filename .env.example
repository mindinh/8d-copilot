# ─────────────────────────────────────────────────────────────
#  SAP AI Core — chỉ dùng cho DEV LOCAL
#
#  Trên BTP: KHÔNG đặt mấy biến này. Tạo destination tên AICORE từ service key
#  của AI Core (kèm thuộc tính bổ sung "resourceGroup") rồi bind destination
#  service vào app. Adapter tự ưu tiên destination; chỉ khi không có binding nào
#  nó mới rơi về các biến dưới đây — và probe lúc khởi động sẽ cảnh báo rõ.
#
#  Copy file này thành .env rồi điền. .env đã nằm trong .gitignore.
# ─────────────────────────────────────────────────────────────

# ── Cách 1 (khuyến nghị): dán nguyên service key AI Core dạng JSON một dòng ──
# Đây cũng là quy ước mà @sap-ai-sdk tự nhận. Điền cách này thì bỏ trống cách 2.
AICORE_SERVICE_KEY=

# ── Cách 2: điền rời từng biến ──
# Adapter sẽ tự tổng hợp AICORE_SERVICE_KEY từ mấy biến này cho @sap-ai-sdk dùng.
# LƯU Ý tên biến là AICORE_AUTH_URL (không phải TOKEN_URL) — CDK đọc đúng tên này.
AICORE_AUTH_URL=https://<subdomain>.authentication.<region>.hana.ondemand.com
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_BASE_URL=https://api.ai.prod.<region>.aws.ml.hana.ondemand.com

# Bắt buộc khi chạy bằng credential env. Trên BTP lấy từ destination.
AICORE_RESOURCE_GROUP=default

# ── Chọn model ──
# Model chat mặc định khi tenant chưa cấu hình gì.
AICORE_DEFAULT_MODEL=gemini-2.5-pro

# Model embedding. ĐỔI GIÁ TRỊ NÀY LÀ LÀM MẤT GIÁ TRỊ MỌI VECTOR ĐÃ LƯU —
# vector của hai model không nằm chung một không gian. Đổi thì phải nhúng lại kho.
# Số chiều phải khớp EMBEDDING_DIM trong srv/src/config/ai.ts.
AICORE_MODEL_EMBEDDING=text-embedding-3-small

# ── Tên destination (tuỳ chọn) ──
# Mặc định adapter tìm destination tên AICORE. Đặt biến này để dùng tên khác.
# AICORE_DESTINATION_NAME=AICORE

# ── Đường mock cho unit test ──
# MOCK_LLM=true cho vector 0 và JSON giả, KHÔNG gọi AI Core.
# Bị cấm khi NODE_ENV=production.
# MOCK_LLM=false
