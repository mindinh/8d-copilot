{
  "name": "cnma_proresolve",
  "version": "0.0.1",
  "description": "CNMA Proresolve CAP Service",
  "repository": "<config>",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "cds-serve",
    "dev": "concurrently -k -p \"[{name}]\" -c \"cyan.bold,magenta.bold\" -n \"BE,FE\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "tsx node_modules/@sap/cds-dk/bin/cds-tsx.js watch --profile hybrid --port 4008 < NUL",
    "dev:frontend": "node scripts/wait-backend.mjs && npm run dev --prefix app/cnma_proresolve_ui",
    "watch": "tsx node_modules/@sap/cds-dk/bin/cds-tsx.js watch --profile hybrid --port 4008",
    "dev:all": "powershell -ExecutionPolicy Bypass -File .\\start-dev.ps1",
    "clean": "node -e \"['gen','mta_archives','ui_resources','app/ui_resources','.cnma_proresolve_mta_build_tmp'].forEach(d=>{try{require('fs').rmSync(d,{recursive:true,force:true})}catch(e){}}); try{require('fs').readdirSync('.').filter(f=>/^Makefile.*\\.mta$/.test(f)).forEach(f=>require('fs').unlinkSync(f))}catch(e){}\"",
    "build": "npm run bundle:library && cds build --production && npm run compile:srv",
    "build:mta": "mbt init && make -f Makefile.mta p=cf mtar=cnma_proresolve_0.0.1.mtar && node -e \"try{require('fs').readdirSync('.').filter(f=>/^Makefile.*\\.mta$/.test(f)).forEach(f=>require('fs').unlinkSync(f))}catch(e){}\"",
    "build:cf": "npm run clean && npm run build && npm run build:mta",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "export:prompts": "node --import ./node_modules/tsx/dist/loader.mjs scripts/export-step-prompts.mjs",
    "push:prompts": "node scripts/push-step-config.mjs",
    "bundle:library": "node scripts/bundle-library.mjs",
    "compile:srv": "node scripts/compile-srv.mjs",
    "predeploy": "node scripts/check-approuter-route.mjs && npm run build:cf",
    "deploy": "node scripts/check-cf-target.mjs && cf deploy mta_archives/cnma_proresolve_0.0.1.mtar --retries 1",
    "deploy:cf": "node scripts/check-cf-target.mjs && cf deploy mta_archives/cnma_proresolve_0.0.1.mtar --retries 1",
    "cf:payg": "cf login -a https://api.cf.eu10.hana.ondemand.com",
    "cf:cpea": "cf login -a https://api.cf.eu10-004.hana.ondemand.com",
    "cf:sandbox": "cf target -o proconarum-sandbox-system -s Training",
    "cf:target": "cf target",
    "cf:logs": "cf logs cnma_proresolve_srv",
    "cf:logs:last": "cf logs cnma_proresolve_srv --recent"
  },
  "dependencies": {
    "@cnma/cap-core": "^1.0.0",
    "@cnma/cap-identity": "^1.0.25",
    "@cnma/cap-valuehelp": "^2.7.2",
    "@cnma/cap-workflow": "^1.7.8",
    "@cnma/sap-aicore-integrate": "^3.0.1",
    "@sap-ai-sdk/ai-api": "^2.13.0",
    "@sap-ai-sdk/orchestration": "^2.13.0",
    "@sap/cds": "^8.8.0",
    "@sap/cds-hana": "^2.0.0",
    "@sap/xsenv": "^5.4.0",
    "@sap/xssec": "^4.2.8",
    "axios": "^1.18.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "passport": "^0.7.0"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.9.0",
    "@sap/cds-dk": "^8.9.19",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "concurrently": "^10.0.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3"
  },
  "cds": {
    "build": {
      "target": "gen",
      "tasks": [
        {
          "for": "hana",
          "src": "db"
        },
        {
          "for": "nodejs",
          "src": "srv"
        }
      ]
    },
    "watch": {
      "ignore": [
        "app/**",
        "*.md",
        "resources/**",
        "dist/**"
      ]
    },
    "requires": {
      "db": {
        "kind": "hana-cloud"
      },
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "admin": {
              "password": "123",
              "roles": [
                "admin",
                "Admin",
                "authenticated-user"
              ]
            },
            "developer": {
              "password": "123",
              "roles": [
                "admin",
                "Admin",
                "authenticated-user"
              ]
            }
          }
        },
        "[production]": {
          "kind": "xsuaa"
        }
      }
    }
  }
}
